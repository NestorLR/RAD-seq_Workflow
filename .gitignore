# ============================================================
# RAD-seq_Workflow — .gitignore
# Keep scripts, documentation, metadata, and small example files.
# Ignore raw sequencing data and reproducible pipeline outputs.
# ============================================================

# --- Raw sequencing data (FASTQ / FASTQ.GZ) ---
data/raw/
*.fastq
*.fastq.gz
*.fq
*.fq.gz

# --- Stacks intermediate and result directories ---
data/stacks/
data/stacks_paired_fixed/

# Common bioinformatics output files (in case stored elsewhere)
*.bam
*.bai
*.sam
*.cram
*.crai
*.vcf
*.vcf.gz
*.bcf
*.tbi
*.csi
*.fastq.tmp
*.fq.tmp

# Large generated variant files
*.g.vcf
*.g.vcf.gz

# Sequence/alignment files (FASTA, PHYLIP, ALN, etc.) are not ignored globally:
# small teaching examples or reference files can be version-controlled.
# Keep large datasets in data/raw/ or data/stacks/, which are ignored above.

# --- Logs and temporary files ---
*.log
*.out
*.err
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- R / RStudio ---
.Rhistory
.RData
.Ruserdata
.Rproj.user/
renv/library/
renv/staging/

# --- Python ---
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
env/

# --- Conda environments (do not commit installed environments) ---
.conda/
conda-meta/
# Export environment specifications explicitly if needed:
# environment.yml
# requirements.txt

# --- IDEs ---
.vscode/
.idea/

# --- Git LFS temporary files ---
.lfsconfig.tmp

# --- Keep directory placeholders when useful ---
!data/raw/.gitkeep
!data/stacks/.gitkeep
!data/stacks_paired_fixed/.gitkeep
